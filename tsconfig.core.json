{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "supabase/functions/_shared/**/*.ts",
    "supabase/functions/generate-prediction/groq.ts",
    "scripts/backtest.ts",
    "tests/**/*.test.ts",
    "src/lib/catalogue.ts",
    "scripts/**/*.ts"
  ]
}
