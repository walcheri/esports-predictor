# ── Режим ────────────────────────────────────────────
# development — Vite :5173 + API :8000
# production  — фронт и API на одном порту (:8000)
APP_ENV=development
SERVE_STATIC=false

# Dev: 127.0.0.1. Запуск API: npm run dev:backend (из корня проекта)
HOST=127.0.0.1
PORT=8000
WORKERS=1

# ── База данных ──────────────────────────────────────
# Пусто = SQLite predict.db в корне проекта
# Docker dev (npm run docker:db):
# DATABASE_URL=postgresql://predict:predict@127.0.0.1:5432/predict
DATABASE_URL=

# ── Безопасность ─────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── PandaScore (матчи, логотипы, трансляции) ───────
# Документация: https://developers.pandascore.co/docs/getting-started
# Токен: dashboard на https://pandascore.co/ → API token
# Бэкенд передаёт токен как Authorization: Bearer <ключ>
PANDASCORE_API_KEY=UolpWEqpRLw---XzZc7pp2Ro1KHnFN7dPFSWwR9lZMik7-fyE4E
PANDASCORE_BASE_URL=https://api.pandascore.co
SYNC_ON_STARTUP=true
SYNC_INTERVAL_MINUTES=15

# ── LLM-отчёты (AITUNNEL, OpenAI-совместимый API) ────
# Документация: https://docs.aitunnel.ru/
# Ключ: https://aitunnel.ru/ → раздел «Ключи»
# Без ключа — только отчёт на данных PandaScore, без AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.aitunnel.ru/v1

# ── Email (подтверждение регистрации) ──────────────
# Рекомендуется Resend (HTTPS, работает из Docker): https://resend.com/
RESEND_API_KEY=
EMAIL_FROM=Esports Predictor <onboarding@resend.dev>
# Альтернатива — SMTP (из Docker часто блокируется провайдером):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_USE_TLS=true
EMAIL_VERIFICATION_TTL_SECONDS=120
EMAIL_DEV_EXPOSE_CODE=false

# ── Лимиты запросов на прогнозы ────────────────────
FREE_PREDICTION_LIMIT=1
PREMIUM_PREDICTION_LIMIT=20

# ── CORS ─────────────────────────────────────────────
# Dev: origin Vite. Prod: ваш домен
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend (только dev-сборка) ─────────────────────
# В prod используйте .env.production (пустой = same-origin /api)
VITE_API_URL=http://localhost:8000

# ── Docker Compose (PostgreSQL, опционально) ─────────
POSTGRES_USER=predict
POSTGRES_PASSWORD=change-me
POSTGRES_DB=predict
